# Backend environment variables (Express API)

# In production, set NODE_ENV=production. This gates: error-response detail
# (backend/src/middleware/errorHandler.ts strips stack/internal messages
# from client responses when production), structured JSON logging vs.
# pretty-printed dev logs (backend/src/config/logger.ts), and Express/cookie
# security defaults. Docker/docker-compose set this automatically -- see
# root docker-compose.yml.
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Postgres (every live domain -- Auth, Messaging, Students, Attendance,
# Homework, CMS, Admissions, Blog, Gallery, Events, Fees, Audit, Settings --
# lives here now, see backend/prisma/schema.prisma). Provision a real
# instance and run `npx prisma migrate deploy` (or `migrate dev` locally)
# before starting the server -- the server will fail fast without a
# reachable DATABASE_URL. In docker-compose this is wired to the `postgres`
# service automatically; only set it manually for bare-metal/local runs.
DATABASE_URL=postgresql://kaylan:kaylan@localhost:5432/kaylan_preschool?schema=public

# pino log level (backend/src/config/logger.ts). One of: fatal, error, warn,
# info, debug, trace. Defaults to "info" in production, "debug" otherwise.
LOG_LEVEL=info

# NOTE: MONGODB_URI has been removed. The pre-Postgres Mongoose scaffold
# (backend/src/models/Admission.ts, Event.ts, Rsvp.ts) is dead code -- it
# type-checks but is never connected to any database in this configuration
# (see backend/src/config/db.ts, unused). Do not re-add this var unless
# actually resuming that migration path.

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Kaylan Preschool <no-reply@kaylanpreschool.com>"

# Max upload size (bytes) enforced by multer + messageController attachment
# validation.
MAX_UPLOAD_BYTES=10485760
