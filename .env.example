# Frontend environment variables (Next.js)

# In production, set NODE_ENV=production (Next.js sets this automatically
# for `next build`/`next start`; only relevant to state explicitly for
# Docker/other custom runners). Gates app/error.tsx-style generic-vs-verbose
# error detail and Next.js's own dev-only warnings/overlays.

# Canonical site origin, used by app/sitemap.ts and app/robots.ts to build
# absolute URLs. Set to the real production domain when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the real backend API (see /backend). Only used once
# NEXT_PUBLIC_USE_MOCK_API is switched to "false".
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# When "true" (default), lib/api/* uses the in-memory mock implementations
# instead of calling NEXT_PUBLIC_API_URL. Flip to "false" once the real
# Express + Prisma + PostgreSQL backend in /backend is running (Auth and
# Messaging are LIVE on it; every other domain -- CMS, Admissions, Blog,
# Gallery, Events, Fees, Students, etc. -- is still served by this Next.js
# app's own app/api/** JSON-file routes regardless of this flag).
NEXT_PUBLIC_USE_MOCK_API=true

# Must be byte-for-byte identical to backend/.env's JWT_ACCESS_SECRET.
# middleware.ts (Edge runtime) verifies the backend-issued access token
# with this secret directly via `jose`, without a network round-trip to
# the backend, so route-guarding still works even if the backend is briefly
# unreachable. Only used when NEXT_PUBLIC_USE_MOCK_API=false.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret

# Socket.io server URL (the Express backend's HTTP server -- Socket.io
# attaches directly to it, see backend/src/socket/index.ts). Used by
# lib/socket/client.ts once messaging is switched to live mode.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
